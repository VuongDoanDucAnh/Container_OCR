<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_OCR.TrangChuPage"
             BackgroundColor="{StaticResource JadeSoft}">

    <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="14">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label x:Name="LblLoiChao"
                   Text="Xin chào"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{StaticResource JadeDark}" />
            <Label x:Name="LblNgay"
                   Text=""
                   FontSize="13"
                   TextColor="{StaticResource Gray500}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Border Grid.Column="0"
                    StrokeShape="RoundRectangle 14"
                    Stroke="Transparent"
                    BackgroundColor="White"
                    Padding="14,12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Đã quét hôm nay"
                           FontSize="12"
                           TextColor="{StaticResource Gray500}" />
                    <Label x:Name="LblSoQuet"
                           Text="0"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="{StaticResource JadePrimary}" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="1"
                    StrokeShape="RoundRectangle 14"
                    Stroke="Transparent"
                    BackgroundColor="White"
                    Padding="14,12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Tin nhắn chưa đọc"
                           FontSize="12"
                           TextColor="{StaticResource Gray500}" />
                    <Label x:Name="LblTinChuaDoc"
                           Text="0"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="{StaticResource JadeDark}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Button Grid.Row="2"
                Text="💰 Báo chi phí xăng dầu"
                FontSize="14"
                HeightRequest="44"
                CornerRadius="10"
                BackgroundColor="{StaticResource JadePrimary}"
                TextColor="White"
                Clicked="BtnChiPhi_Clicked" />

        <ActivityIndicator Grid.Row="3"
                            x:Name="LoadingTrangChu"
                            IsRunning="False"
                            IsVisible="False"
                            Color="{StaticResource JadePrimary}" />

        <RefreshView Grid.Row="4" x:Name="RvTrangChu" Refreshing="RvTrangChu_Refreshing">
            <CollectionView x:Name="CvChuyen">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" Padding="0,40,0,0" Spacing="6">
                        <Label Text="📭" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Hôm nay bạn chưa được phân công chuyến nào"
                               FontSize="14"
                               TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 14"
                                Stroke="Transparent"
                                BackgroundColor="White"
                                Padding="16,14"
                                Margin="0,0,0,12">
                            <VerticalStackLayout Spacing="8">

                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding MaDon}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource JadeDark}" />
                                    <Border Grid.Column="1"
                                            StrokeShape="RoundRectangle 10"
                                            Stroke="Transparent"
                                            BackgroundColor="{Binding MauTrangThai}"
                                            Padding="10,3">
                                        <Label Text="{Binding NhanTrangThai}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="White" />
                                    </Border>
                                </Grid>

                                <Label Text="{Binding TenTuyen}"
                                       FontSize="14"
                                       FontAttributes="Bold" />
                                <Label FontSize="12" TextColor="{StaticResource Gray500}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding DiemDi}" />
                                            <Span Text="  →  " />
                                            <Span Text="{Binding DiemDen}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Label Text="{Binding LoaiHang}" FontSize="13" />

                                <Label Text="{Binding GhiChu}"
                                       FontSize="12"
                                       TextColor="#C62828"
                                       IsVisible="{Binding CoGhiChu}" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                                    <Button Grid.Column="0"
                                            Text="Chỉ đường"
                                            FontSize="13"
                                            BackgroundColor="{StaticResource JadeSoft}"
                                            TextColor="{StaticResource JadeDark}"
                                            HeightRequest="42"
                                            Clicked="BtnChiDuong_Clicked" />

                                    <Button Grid.Column="1"
                                            Text="Xác nhận đã nhận hàng"
                                            FontSize="12"
                                            IsVisible="{Binding HienNutBatDau}"
                                            BackgroundColor="{StaticResource JadePrimary}"
                                            TextColor="White"
                                            HeightRequest="42"
                                            Clicked="BtnBatDau_Clicked" />
                                    
                                    <Button Grid.Column="1"
                                            Text="Xác nhận kết thúc chuyến"
                                            FontSize="12"
                                            IsVisible="{Binding HienNutHoanThanh}"
                                            BackgroundColor="{StaticResource JadeDark}"
                                            TextColor="White"
                                            HeightRequest="42"
                                            Clicked="BtnHoanThanh_Clicked" />
                                </Grid>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>