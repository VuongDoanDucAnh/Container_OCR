<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_OCR.CaNhanPage"
             BackgroundColor="{StaticResource JadeSoft}">

    <ScrollView>
        <VerticalStackLayout Padding="20,20" Spacing="16">

            <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                <Border StrokeShape="RoundRectangle 50" Stroke="{StaticResource JadePrimary}"
                        StrokeThickness="2" WidthRequest="90" HeightRequest="90" Padding="0">
                    <Image Source="dotnet_bot.png" Aspect="AspectFill" />
                </Border>
                <Label x:Name="LblMaTaiXe" Text="Mã tài xế: —" FontSize="14"
                       TextColor="{StaticResource Gray500}" />
            </VerticalStackLayout>

            <Border StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="18" Stroke="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Thông tin cá nhân" FontSize="17" FontAttributes="Bold"
                           TextColor="{StaticResource JadeDark}" />
                    <Entry x:Name="EntryHoTen" Placeholder="Họ tên" />
                    <Entry x:Name="EntrySoDienThoai" Placeholder="Số điện thoại " />
                    <Button x:Name="BtnLuuThongTin" Text="Lưu thông tin"
                            BackgroundColor="{StaticResource JadePrimary}" TextColor="White"
                            CornerRadius="8" Clicked="BtnLuuThongTin_Clicked" />
                    <Label x:Name="LblKetQuaThongTin" Text="" HorizontalOptions="Center" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="18" Stroke="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Đổi mật khẩu" FontSize="17" FontAttributes="Bold"
                           TextColor="{StaticResource JadeDark}" />
                    <Entry x:Name="EntryMatKhauCu" Placeholder="Mật khẩu cũ" IsPassword="True" />
                    <Entry x:Name="EntryMatKhauMoi" Placeholder="Mật khẩu mới" IsPassword="True" />
                    <Button x:Name="BtnDoiMatKhau" Text="Đổi mật khẩu"
                            BackgroundColor="{StaticResource JadeLight}" TextColor="White"
                            CornerRadius="8" Clicked="BtnDoiMatKhau_Clicked" />
                    <Label x:Name="LblKetQuaMatKhau" Text="" HorizontalOptions="Center" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator x:Name="LoadingCaNhan" IsRunning="False" IsVisible="False"
                                Color="{StaticResource JadePrimary}" />

            <Button Text="Đăng xuất" BackgroundColor="{StaticResource JadeDark}"
                    TextColor="White" CornerRadius="8" Margin="0,10,0,0"
                    Clicked="BtnDangXuat_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>