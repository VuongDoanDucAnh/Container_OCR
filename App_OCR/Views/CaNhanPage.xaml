<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_OCR.CaNhanPage"
             BackgroundColor="{StaticResource JadeSoft}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <Border StrokeShape="RoundRectangle 0,0,28,28"
                    Stroke="Transparent"
                    BackgroundColor="{StaticResource JadePrimary}"
                    Padding="24,40,24,30">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Border StrokeShape="RoundRectangle 40"
                            Stroke="White"
                            StrokeThickness="2"
                            BackgroundColor="{StaticResource JadeDark}"
                            WidthRequest="80"
                            HeightRequest="80"
                            Padding="0">
                        <Label x:Name="LblChuCaiDau"
                               Text="TX"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label x:Name="LblTenHienThi"
                           Text="Đang tải..."
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label x:Name="LblMaTaiXe"
                           Text="Mã tài xế: —"
                           FontSize="13"
                           TextColor="{StaticResource JadeSoft}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Padding="20,20" Spacing="16">

                <Border StrokeShape="RoundRectangle 14" BackgroundColor="White" Padding="18" Stroke="Transparent">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Thông tin cá nhân" FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource JadeDark}" />
                        <Label Text="Họ tên" FontSize="12" TextColor="{StaticResource Gray500}" Margin="0,6,0,0" />
                        <Entry x:Name="EntryHoTen" Placeholder="Họ tên" />
                        <Label Text="Số điện thoại" FontSize="12" TextColor="{StaticResource Gray500}" Margin="0,4,0,0" />
                        <Entry x:Name="EntrySoDienThoai" Placeholder="Số điện thoại" Keyboard="Telephone" />
                        <Button x:Name="BtnLuuThongTin" Text="Lưu thông tin"
                                BackgroundColor="{StaticResource JadePrimary}" TextColor="White"
                                CornerRadius="10" HeightRequest="46" Margin="0,8,0,0"
                                Clicked="BtnLuuThongTin_Clicked" />
                        <Label x:Name="LblKetQuaThongTin" Text="" HorizontalOptions="Center" FontSize="13" />
                    </VerticalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 14" BackgroundColor="White" Padding="18" Stroke="Transparent">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Đổi mật khẩu" FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource JadeDark}" />
                        <Entry x:Name="EntryMatKhauCu" Placeholder="Mật khẩu cũ" IsPassword="True" Margin="0,6,0,0" />
                        <Entry x:Name="EntryMatKhauMoi" Placeholder="Mật khẩu mới" IsPassword="True" />
                        <Button x:Name="BtnDoiMatKhau" Text="Đổi mật khẩu"
                                BackgroundColor="Transparent" TextColor="{StaticResource JadePrimary}"
                                BorderColor="{StaticResource JadePrimary}" BorderWidth="1.5"
                                CornerRadius="10" HeightRequest="46" Margin="0,8,0,0"
                                Clicked="BtnDoiMatKhau_Clicked" />
                        <Label x:Name="LblKetQuaMatKhau" Text="" HorizontalOptions="Center" FontSize="13" />
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator x:Name="LoadingCaNhan" IsRunning="False" IsVisible="False"
                                    Color="{StaticResource JadePrimary}" />

                <Button Text="Đăng xuất"
                        BackgroundColor="Transparent"
                        TextColor="#C62828"
                        FontAttributes="Bold"
                        BorderWidth="0"
                        Margin="0,4,0,10"
                        Clicked="BtnDangXuat_Clicked" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>