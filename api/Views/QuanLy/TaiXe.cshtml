@model TaiXeViewModel
@{
    ViewData["Trang"] = "taixe";
    ViewData["TieuDe"] = "Tài xế";
    var vn = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<div class="tieu-de-trang">
    <div>
        <h1>Tài xế</h1>
        <p class="phu">@Model.TaiXes.Count tài xế · chuyến chạy ngày @Model.Ngay.ToString("dd/MM/yyyy", vn)</p>
    </div>
    <div>
        <a class="nut-phu" href="/quanly/email-tai-xe">✉ Email đăng nhập Google</a>
    </div>
</div>

<div class="khung">
    @if (Model.TaiXes.Count == 0)
    {
        <p class="rong">Chưa có tài xế nào đăng ký.</p>
    }
    else
    {
        <div class="cuon-ngang">
            <table class="bang">
                <thead>
                    <tr>
                        <th>Mã tài xế</th>
                        <th>Biển số xe</th>
                        <th>Họ tên</th>
                        <th>Trạng thái hôm nay</th>
                        <th>Chuyến hôm nay</th>
                        <th>Quét hôm nay</th>
                        <th>Tổng đã quét</th>
                        <th>Ngày đăng ký</th>
                        <th>Liên hệ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.TaiXes)
                    {
                        <tr>
                            <td><strong>@t.MaTaiXe</strong></td>
                            <td>
                                <form method="post" action="/quanly/tai-xe/bien-so/@t.Id" style="display:flex;gap:6px;align-items:center">
                                    @Html.AntiForgeryToken()
                                    <input type="text" name="bienSo" value="@t.BienSoXe" placeholder="51C-123.45"
                                           style="width:110px;padding:6px;border:1px solid #b0bec5;border-radius:6px;font-size:12px;" />
                                    <button type="submit" class="nut-phu" style="padding:5px 8px;font-size:11px;">Lưu</button>
                                </form>
                            </td>
                            <td>@t.HoTen</td>
                            <td><span class="huy-hieu @t.LopCss">@t.TrangThaiTongHop</span></td>
                            <td>
                                @if (t.Chuyens.Count == 0)
                                {
                                    <span class="nho">-</span>
                                }
                                else
                                {
                                    foreach (var c in t.Chuyens)
                                    {
                                        <div class="dong-chuyen">
                                            <div>@c.MaDon · @c.TenTuyen</div>
                                            <span class="huy-hieu @NhanHienThi.LopCss(c.TrangThai)">@NhanHienThi.TrangThai(c.TrangThai)</span>
                                        </div>
                                    }
                                }
                            </td>
                            <td>@t.QuetHomNay</td>
                            <td>@t.TongContainerDaQuet</td>
                            <td>@t.NgayTao.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td><a class="nut-phu" href="/quanly/thong-bao?taiXeId=@t.Id">Nhắn tin</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>