@model KeToanViewModel
@{
    ViewData["Trang"] = "ketoan";
    ViewData["TieuDe"] = "Kế toán";
    var vn = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    var tuStr = Model.TuNgay.ToString("yyyy-MM-dd");
    var denStr = Model.DenNgay.ToString("yyyy-MM-dd");
    var tomTat = ViewBag.TomTat as string;
    var loiTomTat = ViewBag.LoiTomTat as string;
    var cauHoiAI = ViewBag.CauHoiAI as string;
    var cauTraLoiAI = ViewBag.CauTraLoiAI as string;
    var loiCauTraLoiAI = ViewBag.LoiCauTraLoiAI as string;
}

<div class="tieu-de-trang">
    <div>
        <h1>Kế toán</h1>
        <p class="phu">Bảng giá cước, bảng lương và chi phí phát sinh</p>
    </div>
</div>

<div style="margin-bottom:16px">
    <a class="nut-phu" href="/quanly/ke-toan" style="background:var(--jade);color:white;">Bảng lương</a>
    <a class="nut-phu" href="/quanly/ke-toan/chi-phi">Chi phí phát sinh</a>
    <a class="nut-phu" href="/quanly/ke-toan/bao-cao-thang">Báo cáo tháng</a>
</div>

<div class="khung">
    <div class="khung-dau">
        <h2>Giá cước theo loại hình chuyến</h2>
    </div>
    @foreach (var lh in Model.DsLoaiHinh)
    {
        <form method="post" action="/quanly/ke-toan/gia-cuoc/@lh.Id"
              style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
            @Html.AntiForgeryToken()
            <span style="min-width:140px;font-weight:600;">@lh.Ten</span>
            <input type="number" name="donGiaMoi" value="@lh.DonGia" step="1000" min="0"
                   style="width:160px;padding:8px;border:1px solid #b0bec5;border-radius:8px;" />
            <span class="nho">đồng / container</span>
            <button type="submit" class="nut-phu">Lưu</button>
        </form>
    }
</div>

<div class="khung">
    <div class="khung-dau">
        <h2>Bảng lương theo tài xế</h2>
    </div>
    <form method="get" action="/quanly/ke-toan" class="bo-loc-ngay" style="margin-bottom:14px;">
        <span class="nho">Từ ngày</span>
        <input type="date" name="tuNgay" value="@tuStr" />
        <span class="nho">Đến ngày</span>
        <input type="date" name="denNgay" value="@denStr" />
        <button type="submit" class="nut-phu">Xem</button>
    </form>

    @if (Model.BangLuong.Count == 0)
    {
        <p class="rong">Không có dữ liệu trong khoảng ngày này.</p>
    }
    else
    {
        <div class="cuon-ngang">
            <table class="bang">
                <thead>
                    <tr>
                        <th>Mã tài xế</th>
                        <th>Họ tên</th>
                        <th>Container hợp lệ (đã phân loại)</th>
                        <th>Chưa phân loại</th>
                        <th>Tổng tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.BangLuong)
                    {
                        <tr>
                            <td><strong>@d.MaTaiXe</strong></td>
                            <td>@d.HoTen</td>
                            <td>@d.SoContainer</td>
                            <td>
                                @d.SoChuaPhanLoai
                                @if (d.SoChuaPhanLoai > 0)
                                {
                                    <span class="huy-hieu khong">Cần bổ sung loại hình</span>
                                }
                            </td>
                            <td><strong>@d.TongTien.ToString("N0", vn) đ</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <form method="post" action="/quanly/ke-toan/tom-tat" style="margin-top:16px">
            @Html.AntiForgeryToken()
            <input type="hidden" name="tuNgay" value="@tuStr" />
            <input type="hidden" name="denNgay" value="@denStr" />
            <button type="submit" class="nut-phu">✨ Tạo tóm tắt AI cho kỳ này</button>
            <span class="nho">Mỗi lần bấm dùng 1 lượt gọi AI, hạn chế bấm lặp lại nhiều lần.</span>
        </form>

        @if (!string.IsNullOrEmpty(tomTat))
        {
            <div class="khung" style="margin-top:12px;background:var(--jade-nhat);border-left:4px solid var(--jade);">
                <div class="khung-dau"><h2>Tóm tắt AI</h2></div>
                <p style="white-space:pre-wrap;margin:0">@tomTat</p>
            </div>
        }
        @if (!string.IsNullOrEmpty(loiTomTat))
        {
            <p style="color:#c62828;margin-top:10px">@loiTomTat</p>
        }
    }
</div>

<div class="khung">
    <div class="khung-dau">
        <h2>💬 Hỏi trợ lý AI</h2>
    </div>
    <p class="nho" style="margin-top:0">
        Trả lời dựa trên số liệu theo tài xế và theo tuyến (gồm lợi nhuận tạm tính) trong khoảng ngày đã chọn ở trên.
        Lưu ý: lợi nhuận theo tuyến chưa trừ tiền dầu, vì chi phí dầu hiện chỉ ghi theo tài xế.
    </p>
    <form method="post" action="/quanly/ke-toan/hoi-ai">
        @Html.AntiForgeryToken()
        <input type="hidden" name="tuNgay" value="@tuStr" />
        <input type="hidden" name="denNgay" value="@denStr" />
        <textarea name="cauHoi" rows="2" placeholder="Ví dụ: Tuyến nào có lợi nhuận tạm tính cao nhất?"
                  style="width:100%;padding:9px;border:1px solid #b0bec5;border-radius:8px;margin-bottom:8px;">@cauHoiAI</textarea>
        <button type="submit" class="nut-phu" style="background:var(--jade);color:white;">Gửi câu hỏi</button>
    </form>

    @if (!string.IsNullOrEmpty(cauTraLoiAI))
    {
        <div class="khung" style="margin-top:12px;background:var(--jade-nhat);border-left:4px solid var(--jade);">
            <p style="white-space:pre-wrap;margin:0">@cauTraLoiAI</p>
        </div>
    }
    @if (!string.IsNullOrEmpty(loiCauTraLoiAI))
    {
        <p style="color:#c62828;margin-top:10px">@loiCauTraLoiAI</p>
    }
</div>